# Canaan Preserve local configuration
# Copy to .env.local for overrides. The app runs without this file in development.

# Required in production. Development default: canaan-admin
ADMIN_PASSWORD=canaan-admin

# Required in production. Signs the admin session cookie.
ADMIN_SESSION_SECRET=change-me-in-production

# file (default for `npm run dev`) or cloudflare (D1 + R2; set automatically on Workers)
STORAGE_ADAPTER=file

# Canaan Ranch LLP witness (seller-side, not on public intake).
# Defaults: Andrew Fuddy / witness@canaanpreserve.com
CANAAN_WITNESS_NAME=Andrew Fuddy
CANAAN_WITNESS_EMAIL=witness@canaanpreserve.com

# ---------------------------------------------------------------------------
# DocuSign
# Keep DOCUSIGN_ENABLED=false to use the local stub (default).
# Set DOCUSIGN_ENABLED=true only after User ID, Account ID, and a JWT RSA
# private key are in place. Never commit real secret values.
# DOCUSIGN_USER_ID and DOCUSIGN_ACCOUNT_ID are env/Cloudflare secrets only —
# this file may show the variable names, never real GUIDs.
# ---------------------------------------------------------------------------
DOCUSIGN_ENABLED=false
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCOUNT_BASE_URI=https://demo.docusign.net
DOCUSIGN_AUTH_SERVER=https://account-d.docusign.com
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_WEBHOOK_SECRET=
DOCUSIGN_WEBHOOK_URL=
DOCUSIGN_RETURN_URL=http://localhost:3000/api/docusign/return
