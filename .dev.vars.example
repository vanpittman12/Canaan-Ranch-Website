# Copy to .dev.vars for `npm run preview` (Workers runtime locally).
# Do not commit .dev.vars.
NEXTJS_ENV=development
STORAGE_ADAPTER=cloudflare
ADMIN_PASSWORD=canaan-admin
ADMIN_SESSION_SECRET=canaan-preserve-dev-session-secret
CANAAN_WITNESS_NAME=Canaan Witness
CANAAN_WITNESS_EMAIL=vpittman@bourne-partners.com
DOCUSIGN_ENABLED=false
DOCUSIGN_ACCOUNT_BASE_URI=https://demo.docusign.net
DOCUSIGN_AUTH_SERVER=https://account-d.docusign.com
DOCUSIGN_RETURN_URL=http://localhost:3000/api/docusign/return
# Leave the following empty locally unless testing live send:
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_SECRET_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_PRIVATE_KEY=
# DOCUSIGN_WEBHOOK_SECRET=

# New-engagement email (Gmail API). Unset = console stub. Never commit secrets.
APP_URL=http://localhost:3000
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_USER=vpittman@beachparkcap.com
# NOTIFY_NEW_ENGAGEMENT_TO=vpittman@beachparkcap.com
